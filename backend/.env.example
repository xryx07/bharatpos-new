# BharatPOS Backend Environment Configuration
PORT=8083
NODE_ENV=production

# Firebase Admin Configuration (For Production Firestore & Auth)
FIREBASE_PROJECT_ID=bharatpos-production
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@bharatpos-production.iam.gserviceaccount.com
# Use literal newlines or \n escaped private key string
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Payment Gateways (Optional / Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Messaging & Alerts (Optional)
FAST2SMS_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
